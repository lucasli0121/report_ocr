{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "process",
			"label": "docker-build",
			"command": "docker",
			"args": [
				"build",
				"-t",
				"reportocr:latest",
				"-f",
				"${workspaceFolder}/Dockerfile",
				"${workspaceFolder}"
			]
		},
		{
			"type": "process",
			"label": "docker-run: debug",
			"command": "run",
			// "dependsOn": [
			// 	"docker-build"
			// ],
			"args": [
				"--rm",
				"-it",
				"reportocr:latest",
				"python",
				"main.py"
			]
		}
	]
}